# ==========================================================================
# TopBlogTech Enterprise Security Hardening
# ==========================================================================

# 1. Disable Directory Browsing
Options -Indexes

# 2. Block access to configuration, backups, database dumps, archives, logs and docs.
#    The previous rule only matched names ENDING in ".sql", so
#    "*.sql.bak_*" dumps and "*.zip" backups were publicly downloadable.
<FilesMatch "^(wp-config\.php|wp-config-sample\.php|\.htaccess|\.user\.ini|php\.ini|error_log|readme\.html|license\.txt|README\.md|composer\.(json|lock)|package(-lock)?\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
<FilesMatch "(\.(sql|sqlite|db|zip|tar|tgz|7z|rar|bak|backup|old|orig|save|swp|tmp|log|md|ini|sh|env|dist)$)|(\.(sql|tar)\.)|(\.bak[._-])">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Version control metadata, maintenance tooling and private reports are never public.
    RewriteRule (^|/)\.(git|svn|github|vscode|idea)(/|$) - [R=404,L,NC]
    RewriteRule ^(tools|audit-reports|private-backups)(/|$) - [R=404,L,NC]
    # Never execute scripts from the uploads directory.
    RewriteRule ^wp-content/uploads/.*\.(php[0-9]?|phtml|phar|pl|py|cgi|sh)$ - [F,L,NC]
</IfModule>

# 3. Block XML-RPC (Prevents 95% of Brute-Force & DDoS Attacks)
<Files "xmlrpc.php">
    Order allow,deny
    Deny from all
</Files>

# 4. HTTP Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
</IfModule>

# 4b. Force HTTPS (loop-safe behind Cloudflare: uses the visitor scheme that
#     Cloudflare passes in X-Forwarded-Proto; falls back to %{HTTPS} when the
#     header is absent, i.e. direct origin access).
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:X-Forwarded-Proto} =http [OR]
    RewriteCond %{HTTPS}:%{HTTP:X-Forwarded-Proto} =off:
    RewriteRule ^ https://topblogtech.com%{REQUEST_URI} [R=301,L,NE]
</IfModule>

# 5. Block SQL Injection and Malicious URL Queries
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{QUERY_STRING} (eval\(|base64_decode|concat\(|<script|GLOBALS|\[0-9a-fA-F]{32}) [NC,OR]
    RewriteCond %{QUERY_STRING} (boot\.ini|etc/passwd|win\.ini) [NC,OR]
    RewriteCond %{QUERY_STRING} (benchmark\(|schema\(|information_schema) [NC]
    RewriteRule .* - [F,L]
</IfModule>

# 6. Gzip Compression for Fast Loading
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
</IfModule>

# 7. Leverage Browser Caching
<IfModule mod_expires.c>
    ExpiresActive on
    ExpiresDefault "access plus 1 month"
    # HTML, feeds and sitemaps must revalidate so content fixes are seen immediately.
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/xml "access plus 0 seconds"
    ExpiresByType application/xml "access plus 0 seconds"
    ExpiresByType application/rss+xml "access plus 0 seconds"
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

# BEGIN WordPress
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /

# 301 Permanent Redirects: Legacy -2024 Slugs to Modern Canonical URLs & Deprecated Pages
RewriteRule ^sample-page/?$ https://topblogtech.com/ [R=301,L]
