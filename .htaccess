RewriteRule ^how-to-grow-your-audience-on-x-twitter/?$ https://topblogtech.com/how-to-grow-your-audience-on-x-com/ [R=301,L]
RewriteRule ^faceless-youtube-channel-with-ai-blueprint/?$ https://topblogtech.com/how-to-build-a-high-rpm-faceless-youtube-channel-ai/ [R=301,L]

# 301 Permanent Redirects: Category Consolidation (18 down to 6)
RewriteRule ^category/linkedin-growth/?$ https://topblogtech.com/category/youtube-growth/ [R=301,L]
RewriteRule ^category/self-growth/?$ https://topblogtech.com/category/blogging/ [R=301,L]
RewriteRule ^category/instagram/?$ https://topblogtech.com/category/youtube-growth/ [R=301,L]
RewriteRule ^category/uncategorized/?$ https://topblogtech.com/category/blogging/ [R=301,L]
RewriteRule ^category/affiliate-marketing/?$ https://topblogtech.com/category/online-money/ [R=301,L]
RewriteRule ^category/x-twitter/?$ https://topblogtech.com/category/youtube-growth/ [R=301,L]
RewriteRule ^category/passive-income/?$ https://topblogtech.com/category/online-money/ [R=301,L]
RewriteRule ^category/tech-reviews/?$ https://topblogtech.com/category/tech-ai/ [R=301,L]
RewriteRule ^category/ai-tools/?$ https://topblogtech.com/category/tech-ai/ [R=301,L]
RewriteRule ^category/technology/?$ https://topblogtech.com/category/tech-ai/ [R=301,L]
RewriteRule ^category/finance-wealth/?$ https://topblogtech.com/category/finance/ [R=301,L]

RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>
# END WordPress